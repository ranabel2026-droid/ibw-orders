PORT=3000
# Production: set these when deployed behind ONE trusted HTTPS reverse proxy.
# NODE_ENV=production
# TRUST_PROXY=1
# SECURE_COOKIES=true
# DATA_DIR=/var/data
# ADMIN_PASSWORD=generate-a-long-unique-password
# SESSION_SECRET=generate-at-least-32-random-bytes
# Local server timezone for daily backup at midnight (choose your business timezone).
# TZ=America/Los_Angeles

# Optional SMTP. Setting HOST + FROM enables account verification and password reset.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=IBW Orders <orders@example.com>

# Render free + Neon: set the Neon pooled connection URL in the hosting dashboard.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# PostgreSQL always requires verified TLS and stable ADMIN_PASSWORD / SESSION_SECRET.
# PG_POOL_MAX=5
# For a private CA only: Node supports NODE_EXTRA_CA_CERTS=/absolute/path/to/ca.crt
# REQUIRE_POSTGRES=true  # Render Blueprint sets this to prevent accidental SQLite fallback
